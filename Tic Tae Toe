import java.util.Random;

public class TicTacToeToss {

    public static void main(String[] args) {

        String player1 = "Player 1";
        String player2 = "Player 2";

        char player1Symbol;
        char player2Symbol;
        String currentPlayer;

        Random rand = new Random();
        int toss = rand.nextInt(2); 

        System.out.println("Tossing to decide who starts...");

        if (toss == 0) {
            currentPlayer = player1;
            player1Symbol = 'X';
            player2Symbol = 'O';
        } else {
            currentPlayer = player2;
            player2Symbol = 'X';
            player1Symbol = 'O';
        }

        System.out.println("Toss Result: " + (toss == 0 ? player1 : player2) + " starts first!");
        System.out.println(player1 + " Symbol: " + player1Symbol);
        System.out.println(player2 + " Symbol: " + player2Symbol);
        System.out.println("Current Player: " + currentPlayer);
    }
}