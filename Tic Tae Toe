import java.util.*;

public class TicTacToe {

    public static void displayBoard(char[][] board) {
        System.out.println("Tic-Tac-Toe Board:");
        System.out.println("-----------------");

        for (int i = 0; i < 3; i++) {
            System.out.print("| ");
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + " | ");
            }
            System.out.println();
            System.out.println("-----------------");
        }
    }

    public static void main(String[] args) {
        char[][] board = new char[3][3];

       
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                board[i][j] = '-';
            }
        }

        displayBoard(board);
    }
}