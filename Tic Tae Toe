import java.util.Random;

public class TicTacToe {

    static char[][] board = {
        {'1','2','3'},
        {'4','5','6'},
        {'7','8','9'}
    };

    // Check if move is valid
    public static boolean isValidMove(int pos) {
        int row = (pos - 1) / 3;
        int col = (pos - 1) % 3;

        return board[row][col] != 'X' && board[row][col] != 'O';
    }

    // Computer random move
    public static void computerMove() {
        Random rand = new Random();
        int pos;

        do {
            pos = rand.nextInt(9) + 1; // 1–9
        } while (!isValidMove(pos));

        int row = (pos - 1) / 3;
        int col = (pos - 1) % 3;

        board[row][col] = 'O';

        System.out.println("Computer chose position: " + pos);
    }

    // Display board
    public static void displayBoard() {
        System.out.println();
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + " ");
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {
        displayBoard();
        computerMove();
        displayBoard();
    }
}